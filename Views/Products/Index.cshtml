@model ProductIndexViewModel
@{
    ViewData["Title"] = "Products";
}

<div class="panel">
    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-4">
            <label class="form-label small text-muted mb-1">Search</label>
            <input name="search" value="@Model.Search" class="form-control" placeholder="Name or SKU..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted mb-1">Category</label>
            <select name="categoryId" class="form-select" asp-items="Model.Categories">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted mb-1">Stock status</label>
            <select name="stock" class="form-select">
                <option value="">All</option>
                <option value="low" selected="@(Model.Stock == "low")">Low stock</option>
                <option value="out" selected="@(Model.Stock == "out")">Out of stock</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-primary flex-fill"><i class="bi bi-search"></i></button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="text-muted small">
            @Model.TotalCount product(s) · inventory value Rs @Model.InventoryValue.ToString("N0")
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Add product
        </a>
    </div>

    @if (!Model.Products.Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            No products match this view.
            <div class="mt-2"><a asp-action="Create" class="btn btn-sm btn-outline-primary">Add your first product</a></div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th>Category</th>
                        <th class="text-end">Cost</th>
                        <th class="text-end">Price</th>
                        <th class="text-end">Stock</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Products)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@p.Id" class="fw-semibold text-decoration-none">@p.Name</a>
                                @if (!p.IsActive)
                                {
                                    <span class="badge text-bg-secondary ms-1">Inactive</span>
                                }
                            </td>
                            <td class="text-muted">@p.Sku</td>
                            <td>@p.Category?.Name</td>
                            <td class="text-end text-muted">@p.PurchasePrice.ToString("N0")</td>
                            <td class="text-end">@p.SellingPrice.ToString("N0")</td>
                            <td class="text-end">@p.Quantity</td>
                            <td>
                                @if (p.IsOutOfStock)
                                {
                                    <span class="badge text-bg-danger">Out of stock</span>
                                }
                                else if (p.IsLowStock)
                                {

                                    <span class="badge text-bg-warning">Low</span>
                                }
                                else
                                {

                                    <span class="badge text-bg-success">In stock</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>