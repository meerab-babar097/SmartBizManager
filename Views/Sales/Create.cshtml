@model SaleCreateViewModel
@{
    ViewData["Title"] = "New sale";
}

<div class="panel" style="max-width: 950px;">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <form asp-action="Create" method="post" id="sale-form">
        @Html.AntiForgeryToken()

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label">Customer</label>
                <select name="CustomerId" asp-items="Model.Customers" class="form-select">
                    <option value="">Walk-in customer</option>
                </select>
            </div>
        </div>

        <table class="table align-middle" id="items-table">
            <thead><tr><th style="width:40%">Product</th><th style="width:15%">Qty</th><th class="text-end">Price</th><th class="text-end">Line total</th><th></th></tr></thead>
            <tbody id="items-body"></tbody>
        </table>

        <button type="button" id="add-row" class="btn btn-sm btn-outline-primary mb-3">
            <i class="bi bi-plus-lg me-1"></i> Add product
        </button>

        <div class="row justify-content-end">
            <div class="col-md-5">
                <div class="d-flex justify-content-between mb-2"><span>Subtotal</span><span id="subtotal-display">Rs 0</span></div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label for="discount-input" class="mb-0">Discount</label>
                    <input type="number" name="Discount" id="discount-input" class="form-control text-end" style="width:140px" value="0" step="0.01" min="0" />
                </div>
                <div class="d-flex justify-content-between fw-bold mb-2"><span>Total</span><span id="total-display">Rs 0</span></div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label for="paid-input" class="mb-0">Amount paid</label>
                    <input type="number" name="AmountPaid" id="paid-input" class="form-control text-end" style="width:140px" value="0" step="0.01" min="0" />
                </div>
                <div class="d-flex justify-content-between text-muted"><span>Remaining</span><span id="remaining-display">Rs 0</span></div>
            </div>
        </div>

        <div class="mt-3">
            <label class="form-label">Notes</label>
            <textarea name="Notes" class="form-control" rows="2"></textarea>
        </div>

        <hr class="my-4" />
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Complete sale</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </form>
</div>

<template id="row-template">
    <tr class="item-row">
        <td>
            <select class="form-select product-select"></select>
        </td>
        <td><input type="number" class="form-control qty-input" value="1" min="1" /></td>
        <td class="text-end price-display">Rs 0</td>
        <td class="text-end line-total-display">Rs 0</td>
        <td><button type="button" class="btn btn-sm btn-outline-danger remove-row"><i class="bi bi-x-lg"></i></button></td>
    </tr>
</template>

<script type="application/json" id="products-data">@Html.Raw(Model.ProductsJson)</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/sale-create.js"></script>
}