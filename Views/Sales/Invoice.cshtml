@model Sale
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Invoice @Model.InvoiceNumber</title>
    <style>
        body { font-family: "Segoe UI", sans-serif; color: #1f2937; padding: 40px; max-width: 800px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; border-bottom: 3px solid #1f6feb; padding-bottom: 16px; margin-bottom: 24px; }
        .brand { font-size: 1.5rem; font-weight: 700; color: #1f6feb; }
        table { width: 100%; border-collapse: collapse; margin: 20px 0; }
        th, td { padding: 8px 10px; text-align: left; border-bottom: 1px solid #e5e7eb; }
        th { font-size: .8rem; text-transform: uppercase; color: #6b7280; }
        .text-end { text-align: right; }
        .totals { width: 300px; margin-left: auto; }
        .totals div { display: flex; justify-content: space-between; padding: 4px 0; }
        .grand-total { font-weight: 700; font-size: 1.15rem; border-top: 2px solid #1f2937; padding-top: 8px; margin-top: 6px; }
        .status { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: .8rem; font-weight: 600; }
        .status.paid { background: #dcfce7; color: #166534; }
        .status.due { background: #fef3c7; color: #92400e; }
        .no-print { margin-top: 30px; }
        @@media print { .no-print { display: none; } body { padding: 0; } }
    </style>
</head>
<body>
    <div class="header">
        <div>
            <div class="brand">SmartBiz Manager</div>
            <div style="color:#6b7280; font-size:.9rem;">Invoice</div>
        </div>
        <div style="text-align:right;">
            <div><strong>@Model.InvoiceNumber</strong></div>
            <div style="color:#6b7280; font-size:.9rem;">@Model.SaleDate.ToString("dd MMM yyyy, hh:mm tt")</div>
        </div>
    </div>

    <div style="margin-bottom:20px;">
        <div style="color:#6b7280; font-size:.85rem;">BILLED TO</div>
        <div style="font-weight:600;">@(Model.Customer?.Name ?? "Walk-in customer")</div>
        @if (Model.Customer?.Phone != null)
        {
            <div style="color:#6b7280;">@Model.Customer.Phone</div>
        }
    </div>

    <table>
        <thead><tr><th>Product</th><th class="text-end">Qty</th><th class="text-end">Unit price</th><th class="text-end">Total</th></tr></thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td class="text-end">@item.Quantity</td>
                    <td class="text-end">Rs @item.UnitPrice.ToString("N0")</td>
                    <td class="text-end">Rs @item.LineTotal.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="totals">
        <div><span>Subtotal</span><span>Rs @Model.Subtotal.ToString("N0")</span></div>
        <div><span>Discount</span><span>Rs @Model.Discount.ToString("N0")</span></div>
        <div class="grand-total"><span>Total</span><span>Rs @Model.Total.ToString("N0")</span></div>
        <div><span>Paid</span><span>Rs @Model.AmountPaid.ToString("N0")</span></div>
        <div><span>Remaining</span><span>Rs @Model.Remaining.ToString("N0")</span></div>
        <div style="margin-top:10px;">
            @if (Model.IsFullyPaid)
            {
                <span class="status paid">PAID IN FULL</span>
            }
            else
            {

                <span class="status due">PAYMENT DUE</span>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div style="margin-top:24px; color:#6b7280; font-size:.9rem;">@Model.Notes</div>
    }

    <div class="no-print" style="text-align:center;">
        <button onclick="window.print()" style="padding:10px 24px; background:#1f6feb; color:#fff; border:none; border-radius:8px; cursor:pointer; font-size:.95rem;">
            Print / Save as PDF
        </button>
    </div>
</body>
</html>