@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card d-flex justify-content-between">
            <div><div class="label">Active products</div><div class="value">@Model.TotalProducts</div></div>
            <i class="bi bi-box-seam icon"></i>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card d-flex justify-content-between">
            <div><div class="label">Sales today</div><div class="value">Rs @Model.SalesToday.ToString("N0")</div></div>
            <i class="bi bi-cash-coin icon"></i>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card d-flex justify-content-between">
            <div><div class="label">Customers</div><div class="value">@Model.TotalCustomers</div></div>
            <i class="bi bi-people icon"></i>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card d-flex justify-content-between">
            <div><div class="label">Low stock</div><div class="value text-warning">@Model.LowStockCount</div></div>
            <i class="bi bi-exclamation-triangle icon"></i>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card d-flex justify-content-between">
            <div><div class="label">Out of stock</div><div class="value text-danger">@Model.OutOfStockCount</div></div>
            <i class="bi bi-x-octagon icon"></i>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="stat-card">
            <div class="label">Inventory value (at cost)</div>
            <div class="value">Rs @Model.InventoryValue.ToString("N0")</div>
            <div class="small text-muted mt-2">Quantity × purchase price, across all products.</div>
        </div>
        <hr class="my-3" />
        <div class="label">Expenses this month</div>
        <div class="value" style="font-size:1.3rem;">Rs @Model.ExpensesThisMonth.ToString("N0")</div>
        
    </div>

    <div class="col-lg-8">
        <div class="panel">
            <div class="panel-title">Needs restocking</div>
            @if (!Model.LowStockProducts.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-check2-circle"></i>
                    Every product is above its low-stock threshold.
                </div>
            }
            else
            {
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr><th>Product</th><th>Category</th><th class="text-end">In stock</th><th class="text-end">Threshold</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.LowStockProducts)
                        {
                            <tr>
                                <td><a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">@p.Name</a></td>
                                <td class="text-muted">@p.Category?.Name</td>
                                <td class="text-end">@p.Quantity</td>
                                <td class="text-end text-muted">@p.LowStockThreshold</td>
                                <td class="text-end">
                                    @if (p.IsOutOfStock)
                                    {
                                        <span class="badge text-bg-danger">Out of stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-warning">Low</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>