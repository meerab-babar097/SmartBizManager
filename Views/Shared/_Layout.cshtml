@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => controller == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · SmartBiz Manager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">

        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <i class="bi bi-shop"></i>
                <span>SmartBiz</span>
            </div>
            <nav class="sidebar-nav">
                <a class="nav-item @Active("Home")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a class="nav-item @Active("Products")" asp-controller="Products" asp-action="Index">
                    <i class="bi bi-box-seam"></i> Products
                </a>
                <a class="nav-item @Active("Customers")" asp-controller="Customers" asp-action="Index">
                    <i class="bi bi-people"></i> Customers
                </a>
                <a class="nav-item @Active("Expenses")" asp-controller="Expenses" asp-action="Index">
                    <i class="bi bi-wallet2"></i> Expenses
                </a>
                <a class="nav-item @Active("Sales")" asp-controller="Sales" asp-action="Index">
                    <i class="bi bi-cart-check"></i> Sales
                </a>
                <a class="nav-item @Active("Reports")" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-graph-up"></i> Reports
                </a>
            </nav>
            <div class="sidebar-footer">v0.1 · MVP</div>
        </aside>

        <div class="app-main">
            <header class="topbar">
                <button class="btn btn-sm btn-light d-lg-none" onclick="document.getElementById('sidebar').classList.toggle('open')">
                    <i class="bi bi-list"></i>
                </button>
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-right text-muted small">@DateTime.Now.ToString("dddd, dd MMM yyyy")</div>
            </header>

            <main class="content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>